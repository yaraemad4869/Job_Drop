{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=jobdrop;Username=postgres;Password=admin"
  },
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_SECURE_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "JobDrop",
    "Audience": "JobDrop"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "BackendAlignment": {
    "SLA": {
      "DefaultDurationHours": 48,
      "PolicyVersion": "v1"
    },
    "MatchBands": {
      "HighThreshold": 90.0,
      "MediumThreshold": 80.0
    },
    "Attachments": {
      "MaxDropAttachmentBytes": 10485760,
      "MaxSupportingAttachments": 5
    }
  },
  "Paymob": {
    "ApiKey": "",
    "HmacSecret": "",
    "BaseUrl": "https://accept.paymob.com/api"
  }
}
